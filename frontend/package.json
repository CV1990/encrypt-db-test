    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.0.4",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "typescript": "~5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.4",
    "vue-tsc": "^2.2.0"
  }
}
